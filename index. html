<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Car Audio Calculator</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #121212;
            color: #ffffff;
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 400px;
            margin: 0 auto;
            background: #1e1e1e;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.5);
        }
        h2 {
            text-align: center;
            color: #00adb5;
        }
        .form-group {
            margin-bottom: 15px;
        }
        label {
            display: block;
            margin-bottom: 5px;
            font-size: 14px;
        }
        input {
            width: 100%;
            padding: 10px;
            box-sizing: border-box;
            background: #2b2b2b;
            border: 1px solid #444;
            color: #fff;
            border-radius: 4px;
        }
        button {
            width: 100%;
            padding: 12px;
            background-color: #00adb5;
            color: white;
            border: none;
            border-radius: 4px;
            font-size: 16px;
            cursor: pointer;
            font-weight: bold;
        }
        button:hover {
            background-color: #007b82;
        }
        .result {
            margin-top: 20px;
            padding: 15px;
            background: #2b2b2b;
            border-radius: 4px;
            text-align: center;
        }
    </style>
</head>
<body>

<div class="container">
    <h2>Car Audio Calculator</h2>
    
    <div class="form-group">
        <label for="voltage">Amplifier Voltage (V):</label>
        <input type="number" id="voltage" placeholder="e.g., 14.4" value="14.4">
    </div>

    <div class="form-group">
        <label for="power">RMS Power (Watts):</label>
        <input type="number" id="power" placeholder="e.g., 1000">
    </div>

    <button onclick="calculateAmps()">Calculate Current</button>

    <div class="result" id="resultArea">
        <h3>Estimated Current:</h3>
        <p id="outputAmps">-- Amps</p>
    </div>
</div>

<script>
    function calculateAmps() {
        const volts = parseFloat(document.getElementById('voltage').value);
        const watts = parseFloat(document.getElementById('power').value);
        
        if (!volts || !watts || volts <= 0) {
            document.getElementById('outputAmps').innerText = "Please enter valid numbers.";
            return;
        }

        // Basic Ohm's Law / Power formula: Amps = Watts / Volts
        const amps = watts / volts;
        document.getElementById('outputAmps').innerText = amps.toFixed(2) + " Amps";
    }
</script>

</body>
</html>
